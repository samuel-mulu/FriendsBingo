# Transport only. Merge selected values into private configuration yourself.
# Keep local PORT=3002 and Docker API PORT=4000 unchanged.
SOCKET_IO_REDIS_ENABLED=false
# Replace <64-hex-password> with the private .secrets/redis-password value.
# Windows host development (NOT the legacy Windows Redis on port 6379):
REDIS_URL=redis://:<64-hex-password>@127.0.0.1:16379/0
# For Docker API use redis://:<64-hex-password>@redis:6379/0 instead.
SOCKET_IO_REDIS_CHANNEL_PREFIX=friends-bingo:local
# Use friends-bingo:staging and friends-bingo:production in those environments.
BINGO_CLAIM_RECOVERY_ENABLED=false
