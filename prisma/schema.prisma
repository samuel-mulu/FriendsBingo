generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PLAYER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum GameStatus {
  NEXT
  READY
  CHECKING
  PLAYING
  WINNER_WINDOW
  FINISHED
  NO_WINNER
  CANCELLED
}

enum GameOperationMode {
  MANUAL
  AUTO
}

enum GameCategory {
  NORMAL
  BONUS
  BIG_GOTD
  BIG_GAME
}

enum GameCartelaStatus {
  REGISTERED
  WINNER
  BLOCKED
  CANCELLED
}

enum GameCartelaReservationStatus {
  ACTIVE
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum BingoClaimStatus {
  PENDING
  VALID
  INVALID
}

enum BingoClaimReasonCode {
  INVALID_PATTERN
  INVALID_LATE_CLAIM
  ALREADY_BLOCKED
  ALREADY_WINNER
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAW_REQUEST
  WITHDRAW_PAID
  WITHDRAW_REFUND
  GAME_ENTRY
  PRIZE_WIN
  REFUND
  ADMIN_ADJUSTMENT
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  CBE
  TELEBIRR
  AWASH
  BOA
}

enum DepositApprovalMode {
  AUTOMATIC
  MANUAL
  LOCAL
}

enum CartelaPaymentSource {
  MONEY_WALLET
  BONUS_CARTELA
}

enum WinnerPhoneDisplayMode {
  HIDDEN
  FULL
  MASKED
}

enum CompanyFeeSource {
  MONEY
  BONUS
}

enum OtpPurpose {
  LOGIN
  REGISTER
  PASSWORD_RESET
}

enum PlayerSupportCategory {
  FEEDBACK
  COMPLAINT
  ADVICE
  OTHER
}

enum PlayerSupportStatus {
  OPEN
  REPLIED
  CLOSED
}

model User {
  id          String     @id @default(uuid())
  fullName    String
  phoneNumber String     @unique
  password    String?
  role        UserRole   @default(PLAYER)
  status      UserStatus @default(ACTIVE)

  wallet       Wallet?
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  transactions WalletTransaction[]

  gameCartelas            GameCartela[]
  gameCartelaReservations GameCartelaReservation[]
  bingoClaims             BingoClaim[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  adminExpenses           AdminExpense[]
  gameTimingConfigUpdates GameTimingConfig[]
  appDisplayConfigUpdates AppDisplayConfig[]
  notificationConfigUpdates NotificationConfig[]
  refreshTokens           RefreshToken[]
  pushDevices             PushDevice[]
  pushDeliveryLogs        PushDeliveryLog[]
  adminBroadcasts         AdminBroadcast[]         @relation("AdminBroadcastCreator")
  broadcastDismissals     AdminBroadcastDismissal[]
  playerSupportMessages   PlayerSupportMessage[]   @relation("SupportMessages")
  supportReplies          PlayerSupportMessage[]   @relation("SupportReplies")
  welcomeBonusGrants      DeviceWelcomeBonusGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  fcmToken   String   @unique
  platform   String
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushDeliveryLog {
  id       String   @id @default(uuid())
  userId   String
  category String
  entityId String   @default("")
  sentAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, entityId])
  @@index([userId, sentAt])
  @@index([category, sentAt])
}

model OtpChallenge {
  id           String     @id @default(uuid())
  phoneNumber  String
  purpose      OtpPurpose
  codeHash     String
  expiresAt    DateTime
  attemptCount Int        @default(0)
  consumedAt   DateTime?
  requestIp    String?
  deviceId     String?
  createdAt    DateTime   @default(now())

  @@index([phoneNumber, purpose, consumedAt, createdAt])
}

model SmsDeliveryLog {
  id        String   @id @default(uuid())
  provider  String
  phone     String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}

model Wallet {
  id            String  @id @default(uuid())
  userId        String  @unique
  balance       Decimal @default(0) @db.Decimal(12, 2)
  lockedBalance Decimal @default(0) @db.Decimal(12, 2)
  bonusCartelaBalance Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeviceWelcomeBonusGrant {
  id          String   @id @default(uuid())
  /// Install UUID at decision time. Positive awards are unique per device in DB
  /// (partial unique index where bonusAmount > 0). Zero rows mark denied users.
  deviceId    String
  userId      String   @unique
  phoneNumber String
  /// 10 when awarded, 0 when permanently denied (e.g. device already claimed).
  bonusAmount Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

model WalletTransaction {
  id     String                @id @default(uuid())
  userId String
  type   WalletTransactionType
  amount Decimal               @db.Decimal(12, 2)

  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  referenceType String?
  referenceId   String?

  description String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, type, referenceType, referenceId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model Deposit {
  id       String          @id @default(uuid())
  userId   String
  provider PaymentProvider
  amount   Decimal         @db.Decimal(12, 2)

  transactionRef String
  status         DepositStatus @default(PENDING)

  receiptUrl            String?
  walletTransactionId   String?
  verifiedData          Json?
  rejectionReason       String?
  verifyEtRequestId     String?
  verifyEtRawResponse   Json?
  verifiedAmount        Decimal? @db.Decimal(12, 2)
  verifiedReceiverName  String?

  user User @relation(fields: [userId], references: [id])

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([provider, transactionRef, status])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@index([walletTransactionId])
}

model DepositApprovalConfig {
  provider     PaymentProvider     @id
  enabled      Boolean             @default(true)
  approvalMode DepositApprovalMode @default(AUTOMATIC)
  updatedAt    DateTime            @updatedAt
  updatedById  String?
}

model Withdrawal {
  id       String          @id @default(uuid())
  userId   String
  provider PaymentProvider
  amount   Decimal         @db.Decimal(12, 2)

  receiverPhone   String?
  receiverAccount String?

  payoutRef            String?        @unique
  payoutTransactionUrl String?
  status               WithdrawStatus @default(PENDING)

  adminNote String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model GameRule {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int
  patterns    Json?

  games GameSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model GameSlot {
  id         String  @id @default(uuid())
  staticCode String  @unique
  name       String
  gameType   String
  gameRuleId String?

  status GameStatus @default(NEXT)

  entryFee        Decimal @default(10) @db.Decimal(12, 2)
  prizePerCartela Decimal @default(8) @db.Decimal(12, 2)
  category        GameCategory @default(NORMAL)
  fixedPrizeAmount Decimal? @db.Decimal(12, 2)
  maxCartelasPerPlayer Int?
  removeAfterFinish Boolean @default(false)

  sortOrder Int?

  operationMode               GameOperationMode @default(MANUAL)
  registrationDurationSeconds Int?
  autoCallIntervalSeconds     Int?

  gameRule GameRule? @relation(fields: [gameRuleId], references: [id])

  sessions GameSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staticCode])
  @@index([gameRuleId])
  @@index([status])
  @@index([status, sortOrder])
  @@index([sortOrder])
  @@index([createdAt])
}

model GameSession {
  id         String @id @default(uuid())
  gameSlotId String
  playCode   String @unique // Unique code per play session

  entryFee             Decimal @default(10) @db.Decimal(12, 2)
  prizePerCartela      Decimal @default(8) @db.Decimal(12, 2)
  companyFeePerCartela Decimal @default(2) @db.Decimal(12, 2)
  prizeAmount          Decimal @default(0) @db.Decimal(12, 2)
  companyRevenue       Decimal @default(0) @db.Decimal(12, 2)

  status GameStatus @default(PLAYING)

  autoCallEnabled    Boolean   @default(false)
  autoCallIntervalMs Int       @default(7000)
  nextAutoCallAt     DateTime?
  registrationOpensAt DateTime?
  scheduledStartAt   DateTime?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  // Why the session ended in CANCELLED status: 'no_players' | 'admin_cancelled'
  cancelledReason String?
  noWinnerGraceEndsAt DateTime?
  noWinnerReason      String?

  winnerWindowStartedAt DateTime?
  winnerWindowEndsAt    DateTime?
  prizeFinalizedAt      DateTime?

  gameSlot GameSlot @relation(fields: [gameSlotId], references: [id])

  gameCartelas            GameCartela[]
  gameCartelaReservations GameCartelaReservation[]
  calledNumbers           CalledNumber[]
  bingoClaims             BingoClaim[]

  winnerCartelaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameSlotId])
  @@index([playCode])
  @@index([status])
  @@index([createdAt])
  @@index([autoCallEnabled, status, nextAutoCallAt])
  @@index([status, scheduledStartAt])
  @@index([status, finishedAt])
  @@index([status, winnerWindowEndsAt, prizeFinalizedAt])
  @@index([status, noWinnerGraceEndsAt])
}

model Cartela {
  id     String @id @default(uuid())
  number Int    @unique

  b Json
  i Json
  n Json
  g Json
  o Json

  gameCartelas            GameCartela[]
  gameCartelaReservations GameCartelaReservation[]

  createdAt DateTime @default(now())
}

model GameCartelaReservation {
  id            String                       @id @default(uuid())
  gameSessionId String
  cartelaId     String
  userId        String
  expiresAt     DateTime
  status        GameCartelaReservationStatus @default(ACTIVE)

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  cartela     Cartela     @relation(fields: [cartelaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameSessionId])
  @@index([gameSessionId, status, expiresAt])
  @@index([cartelaId])
  @@index([userId])
  @@index([status, expiresAt])
}

model GameCartela {
  id            String @id @default(uuid())
  gameSessionId String
  userId        String
  cartelaId     String

  status GameCartelaStatus @default(REGISTERED)

  markedCells Json?
  isWinner    Boolean   @default(false)
  blockedAt   DateTime?

  paymentSource          CartelaPaymentSource?
  entryFeeCents          Int                   @default(0)
  prizeContributionCents Int                   @default(0)
  companyFeeCents        Int                   @default(0)
  companyFeeSource       CompanyFeeSource?

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  cartela     Cartela     @relation(fields: [cartelaId], references: [id])

  bingoClaims BingoClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameSessionId, userId, cartelaId])
  @@unique([gameSessionId, cartelaId])
  @@index([gameSessionId])
  @@index([userId])
  @@index([status])
  @@index([gameSessionId, status])
  @@index([gameSessionId, userId])
}

model CalledNumber {
  id            String @id @default(uuid())
  gameSessionId String
  letter        String
  number        Int
  order         Int

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([gameSessionId, number])
  @@unique([gameSessionId, order])
  @@index([gameSessionId])
  // Unique constraints above also index (gameSessionId, number) and (gameSessionId, order).
}

model BingoClaim {
  id            String @id @default(uuid())
  gameSessionId String
  userId        String
  gameCartelaId String

  status BingoClaimStatus @default(PENDING)

  checkedPattern String?
  reason         String?
  reasonCode     BingoClaimReasonCode?

  winningBallLetter String?
  winningBallNumber Int?

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  gameCartela GameCartela @relation(fields: [gameCartelaId], references: [id])

  createdAt DateTime  @default(now())
  checkedAt DateTime?

  @@index([gameSessionId])
  @@index([userId])
  @@index([status])
  @@index([gameSessionId, status])
  @@index([gameSessionId, gameCartelaId, status])
}

model Notification {
  id      String  @id @default(uuid())
  userId  String
  title   String
  message String
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AdminExpense {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  note        String?
  expenseDate DateTime @default(now())
  createdById String?

  createdBy User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseDate])
  @@index([createdById])
}

model GameTimingConfig {
  id                           String  @id @default("default")
  registrationDurationSeconds  Int     @default(180)
  autoCallIntervalSeconds      Int     @default(18)
  winnerWindowSeconds          Int     @default(25)
  winnerWindowClaimGraceMs     Int     @default(750)
  cartelaHoldSeconds           Int     @default(10)
  bulkSelectionHoldSeconds     Int     @default(120)
  finishedResultDisplaySeconds Int     @default(60)
  winningPatternDisplaySeconds Int    @default(10)
  preparingDisplayMaxSeconds   Int?
  missedNumberAnimationMs      Int     @default(150)
  missedNumberStaggerMaxBalls  Int     @default(10)
  adminRefreshDebounceMs       Int     @default(2500)
  adminFallbackPollingSeconds  Int     @default(5)
  flutterRefetchDebounceMs     Int     @default(400)
  normalDefaultEntryFee             Decimal @default(10) @db.Decimal(12, 2)
  normalDefaultCompanyFeePerCartela Decimal @default(2) @db.Decimal(12, 2)
  updatedById                  String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  updatedAt DateTime @updatedAt
}

model AppDisplayConfig {
  id                      String                 @id @default("default")
  winnerPhoneDisplayMode  WinnerPhoneDisplayMode @default(HIDDEN)
  updatedById             String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  updatedAt DateTime @updatedAt
}

model NotificationConfig {
  id                       String  @id @default("default")
  pushNotificationsEnabled Boolean @default(true)
  updatedById              String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id       String  @id @default(uuid())
  actorId  String?
  action   String
  entity   String
  entityId String?
  metadata Json?

  actor User? @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum AdminBroadcastCategory {
  DISMISSIBLE
  PERSISTENT
  FORCED
}

model AdminBroadcast {
  id          String                  @id @default(uuid())
  title       String
  body        String
  category    AdminBroadcastCategory  @default(DISMISSIBLE)
  createdById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  createdBy  User?                     @relation("AdminBroadcastCreator", fields: [createdById], references: [id])
  dismissals AdminBroadcastDismissal[]

  @@index([createdAt])
  @@index([category])
}

model AdminBroadcastDismissal {
  id          String   @id @default(uuid())
  broadcastId String
  userId      String
  createdAt   DateTime @default(now())

  broadcast AdminBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([userId])
  @@index([broadcastId])
}

model PlayerSupportMessage {
  id          String                @id @default(uuid())
  userId      String
  category    PlayerSupportCategory
  message     String
  status      PlayerSupportStatus   @default(OPEN)

  adminReply  String?
  repliedAt   DateTime?
  repliedById String?
  playerSeenAt DateTime?

  user      User  @relation("SupportMessages", fields: [userId], references: [id], onDelete: Cascade)
  repliedBy User? @relation("SupportReplies", fields: [repliedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([userId, status, playerSeenAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  deviceId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
}
