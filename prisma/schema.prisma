generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PLAYER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum GameStatus {
  NEXT
  READY
  CHECKING
  PLAYING
  WINNER_WINDOW
  FINISHED
  CANCELLED
}

enum GameOperationMode {
  MANUAL
  AUTO
}

enum GameCartelaStatus {
  REGISTERED
  WINNER
  BLOCKED
  CANCELLED
}

enum GameCartelaReservationStatus {
  ACTIVE
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum BingoClaimStatus {
  PENDING
  VALID
  INVALID
}

enum BingoClaimReasonCode {
  INVALID_PATTERN
  INVALID_LATE_CLAIM
  ALREADY_BLOCKED
  ALREADY_WINNER
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAW_REQUEST
  WITHDRAW_PAID
  WITHDRAW_REFUND
  GAME_ENTRY
  PRIZE_WIN
  REFUND
  ADMIN_ADJUSTMENT
}

enum DepositStatus {
  PENDING
  VERIFYING
  APPROVED
  REJECTED
  MANUAL_REVIEW
}

enum WithdrawStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  CBE
  TELEBIRR
}

model User {
  id          String     @id @default(uuid())
  fullName    String
  phoneNumber String     @unique
  password    String?
  role        UserRole   @default(PLAYER)
  status      UserStatus @default(ACTIVE)

  wallet       Wallet?
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  transactions WalletTransaction[]

  gameCartelas            GameCartela[]
  gameCartelaReservations GameCartelaReservation[]
  bingoClaims             BingoClaim[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  adminExpenses           AdminExpense[]
  gameTimingConfigUpdates GameTimingConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id            String  @id @default(uuid())
  userId        String  @unique
  balance       Decimal @default(0) @db.Decimal(12, 2)
  lockedBalance Decimal @default(0) @db.Decimal(12, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id     String                @id @default(uuid())
  userId String
  type   WalletTransactionType
  amount Decimal               @db.Decimal(12, 2)

  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  referenceType String?
  referenceId   String?

  description String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, type, referenceType, referenceId])
  @@index([userId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model Deposit {
  id       String          @id @default(uuid())
  userId   String
  provider PaymentProvider
  amount   Decimal         @db.Decimal(12, 2)

  transactionRef String        @unique
  status         DepositStatus @default(PENDING)

  verifiedData    Json?
  rejectionReason String?

  user User @relation(fields: [userId], references: [id])

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model Withdrawal {
  id       String          @id @default(uuid())
  userId   String
  provider PaymentProvider
  amount   Decimal         @db.Decimal(12, 2)

  receiverPhone   String?
  receiverAccount String?

  payoutRef String?        @unique
  status    WithdrawStatus @default(PENDING)

  adminNote String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model GameRule {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int
  patterns    Json?

  games GameSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model GameSlot {
  id         String  @id @default(uuid())
  staticCode String  @unique
  name       String
  gameType   String
  gameRuleId String?

  status GameStatus @default(NEXT)

  entryFee        Decimal @default(10) @db.Decimal(12, 2)
  prizePerCartela Decimal @default(8) @db.Decimal(12, 2)

  sortOrder Int?

  operationMode               GameOperationMode @default(MANUAL)
  registrationDurationSeconds Int?
  autoCallIntervalSeconds     Int?

  gameRule GameRule? @relation(fields: [gameRuleId], references: [id])

  sessions GameSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staticCode])
  @@index([gameRuleId])
  @@index([status])
  @@index([sortOrder])
  @@index([createdAt])
}

model GameSession {
  id         String @id @default(uuid())
  gameSlotId String
  playCode   String @unique // Unique code per play session

  entryFee             Decimal @default(10) @db.Decimal(12, 2)
  prizePerCartela      Decimal @default(8) @db.Decimal(12, 2)
  companyFeePerCartela Decimal @default(2) @db.Decimal(12, 2)
  prizeAmount          Decimal @default(0) @db.Decimal(12, 2)
  companyRevenue       Decimal @default(0) @db.Decimal(12, 2)

  status GameStatus @default(PLAYING)

  autoCallEnabled    Boolean   @default(false)
  autoCallIntervalMs Int       @default(7000)
  nextAutoCallAt     DateTime?
  scheduledStartAt   DateTime?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  // Why the session ended in CANCELLED status: 'no_players' | 'admin_cancelled'
  cancelledReason String?

  winnerWindowStartedAt DateTime?
  winnerWindowEndsAt    DateTime?
  prizeFinalizedAt      DateTime?

  gameSlot GameSlot @relation(fields: [gameSlotId], references: [id])

  gameCartelas            GameCartela[]
  gameCartelaReservations GameCartelaReservation[]
  calledNumbers           CalledNumber[]
  bingoClaims             BingoClaim[]

  winnerCartelaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameSlotId])
  @@index([playCode])
  @@index([status])
  @@index([createdAt])
  @@index([autoCallEnabled, status, nextAutoCallAt])
  @@index([status, scheduledStartAt])
  @@index([status, winnerWindowEndsAt, prizeFinalizedAt])
}

model Cartela {
  id     String @id @default(uuid())
  number Int    @unique

  b Json
  i Json
  n Json
  g Json
  o Json

  gameCartelas            GameCartela[]
  gameCartelaReservations GameCartelaReservation[]

  createdAt DateTime @default(now())
}

model GameCartelaReservation {
  id            String                       @id @default(uuid())
  gameSessionId String
  cartelaId     String
  userId        String
  expiresAt     DateTime
  status        GameCartelaReservationStatus @default(ACTIVE)

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  cartela     Cartela     @relation(fields: [cartelaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameSessionId])
  @@index([cartelaId])
  @@index([userId])
  @@index([status, expiresAt])
}

model GameCartela {
  id            String @id @default(uuid())
  gameSessionId String
  userId        String
  cartelaId     String

  status GameCartelaStatus @default(REGISTERED)

  markedCells Json?
  isWinner    Boolean   @default(false)
  blockedAt   DateTime?

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  cartela     Cartela     @relation(fields: [cartelaId], references: [id])

  bingoClaims BingoClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameSessionId, userId, cartelaId])
  @@unique([gameSessionId, cartelaId])
  @@index([gameSessionId])
  @@index([userId])
  @@index([status])
  @@index([gameSessionId, status])
  @@index([gameSessionId, userId])
}

model CalledNumber {
  id            String @id @default(uuid())
  gameSessionId String
  letter        String
  number        Int
  order         Int

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([gameSessionId, number])
  @@unique([gameSessionId, order])
  @@index([gameSessionId])
  // Unique constraints above also index (gameSessionId, number) and (gameSessionId, order).
}

model BingoClaim {
  id            String @id @default(uuid())
  gameSessionId String
  userId        String
  gameCartelaId String

  status BingoClaimStatus @default(PENDING)

  checkedPattern String?
  reason         String?
  reasonCode     BingoClaimReasonCode?

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  gameCartela GameCartela @relation(fields: [gameCartelaId], references: [id])

  createdAt DateTime  @default(now())
  checkedAt DateTime?

  @@index([gameSessionId])
  @@index([userId])
  @@index([status])
  @@index([gameSessionId, status])
  @@index([gameSessionId, gameCartelaId, status])
}

model Notification {
  id      String  @id @default(uuid())
  userId  String
  title   String
  message String
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AdminExpense {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  note        String?
  expenseDate DateTime @default(now())
  createdById String?

  createdBy User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseDate])
  @@index([createdById])
}

model GameTimingConfig {
  id                           String  @id @default("default")
  registrationDurationSeconds  Int     @default(60)
  autoCallIntervalSeconds      Int     @default(7)
  winnerWindowSeconds          Int     @default(15)
  cartelaHoldSeconds           Int     @default(10)
  finishedResultDisplaySeconds Int     @default(3)
  preparingDisplayMaxSeconds   Int?
  missedNumberAnimationMs      Int     @default(150)
  missedNumberStaggerMaxBalls  Int     @default(10)
  adminRefreshDebounceMs       Int     @default(2500)
  adminFallbackPollingSeconds  Int     @default(5)
  flutterRefetchDebounceMs     Int     @default(400)
  updatedById                  String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id       String  @id @default(uuid())
  actorId  String?
  action   String
  entity   String
  entityId String?
  metadata Json?

  actor User? @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
