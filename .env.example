# =============================================================================
# Friends Bingo Backend - Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env and configure your private credentials:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGINS=*
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Neon)
# -----------------------------------------------------------------------------
# Primary pooled database connection string:
DATABASE_URL="postgresql://user:password@ep-rough-flower-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Direct database connection string (used for interactive transactions without PgBouncer):
# If left empty, the server automatically derives the direct URL by removing '-pooler'.
DIRECT_URL=""

# Database Pool & Resilience Settings:
PRISMA_SLOW_QUERY_THRESHOLD_MS=1500
DATABASE_POOL_MAX=15
DATABASE_DIRECT_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Authentication & JWT
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d
OTP_RESEND_COOLDOWN_SECONDS=180

# -----------------------------------------------------------------------------
# Settlement Bank Accounts (Deposits & Withdrawals)
# -----------------------------------------------------------------------------
CBE_SETTLEMENT_ACCOUNT=1000000000000
CBE_ACCOUNT_SUFFIX=00000000
CBE_RECEIVER_NAME=Sample Account Name
CBE_RECEIPT_BASE_URL=https://mbreciept.cbe.com.et/receipt

TELEBIRR_SETTLEMENT_ACCOUNT=0900000000
TELEBIRR_RECEIVER_PHONE=0900000000
TELEBIRR_RECEIVER_NAME=Sample Account Name
TELEBIRR_PROVIDER_NAME=Telebirr
TELEBIRR_RECEIPT_BASE_URL=https://transactioninfo.ethiotelecom.et/receipt

AWASH_SETTLEMENT_ACCOUNT=01320000000000
AWASH_ACCOUNT_SUFFIX=0000000
AWASH_RECEIVER_NAME=Sample Account Name

BOA_SETTLEMENT_ACCOUNT=148000000
BOA_ACCOUNT_SUFFIX=00000
BOA_RECEIVER_NAME=Sample Account Name

# -----------------------------------------------------------------------------
# Verify.et Automated Receipt Verification
# -----------------------------------------------------------------------------
VERIFY_ET_API_KEY=your_verify_et_api_key_here
VERIFY_ET_BASE_URL=https://verify.et
VERIFY_ET_WAIT_MS=5000
VERIFY_ET_POLL_ATTEMPTS=20
VERIFY_ET_POLL_INTERVAL_MS=1500

# -----------------------------------------------------------------------------
# GeezSMS OTP Service
# -----------------------------------------------------------------------------
GEEZSMS_ENABLED=true
GEEZSMS_BASE_URL=https://api.geezsms.com/api/v1
GEEZSMS_TOKEN=your_geezsms_api_token_here
GEEZSMS_SHORTCODE_ID=
GEEZSMS_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Firebase Admin (Push Notifications)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Optional Redis Adapter (for horizontal multi-instance WebSocket scaling)
# -----------------------------------------------------------------------------
SOCKET_IO_REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
SOCKET_IO_REDIS_CHANNEL_PREFIX=friends-bingo:local
BINGO_CLAIM_RECOVERY_ENABLED=false

# -----------------------------------------------------------------------------
# Android App Version Policy
# -----------------------------------------------------------------------------
ANDROID_LATEST_VERSION=2.4.1
ANDROID_LATEST_VERSION_CODE=5
ANDROID_MINIMUM_VERSION_CODE=3
ANDROID_APK_DOWNLOAD_URL=https://friendsbingo.netlify.app/download
ANDROID_FORCE_UPDATE=false
